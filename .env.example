# =============================================================================
# EVALUZ - Produkční konfigurace
# Zkopírujte tento soubor jako .env a vyplňte hodnoty
# NIKDY necommitujte .env do git!
# =============================================================================

# --- Databáze ---
# PostgreSQL (produkce) — heslo musí odpovídat POSTGRES_PASSWORD níže
DATABASE_URL=postgresql://evaluz_admin:CHANGEME@db:5432/evaluz_db
POSTGRES_PASSWORD=CHANGEME

# SQLite (pouze pro lokální vývoj — nepoužívat v produkci!)
# DATABASE_URL=sqlite:///./upvsp_evaluator.db

# --- LLM server ---
VLLM_API_URL=http://your-gpu-server:8000/v1
VLLM_MODEL_NAME=qwen2.5-32b-instruct

# --- Bezpečnost / CORS ---
# Produkce: konkrétní doména (bez trailing slash)
# Více domén oddělte čárkou: https://a.cz,https://b.cz
# Lokální vývoj: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=https://your-domain.com

# --- Docker Compose ---
# Port na kterém bude nginx proxy naslouchat na hostiteli
# Externý reverse proxy (HAProxy/nginx hostitele) by měl routovat sem
# HOST_PORT=3000
